# 数据库配置
# 开发环境使用 SQLite，生产环境使用 PostgreSQL

# SQLite 配置 (开发环境)
DATABASE_TYPE=sqlite
SQLITE_DB=sbox.db

# PostgreSQL 配置 (生产环境)
# DATABASE_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sbox
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_MAX_CONN=10

# Flask
SECRET_KEY=your-secret-key-here-change-in-production

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here

# 40code OAuth
CLIENT_ID_40CODE=114514
CLIENT_SECRET_40CODE=your-40code-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=114514
GITHUB_CLIENT_SECRET=your-github-client-secret

# ZeroCat OAuth
ZEROCAT_CLIENT_ID=114514
ZEROCAT_CLIENT_SECRET=your-zerocat-client-secret

# AI API Keys
AI_API_KEY_A=your-siliconflow-api-key
AI_API_KEY_B=your-other-api-key
AI_API_KEY_SILICONFLOW=your-siliconflow-api-key

# Email (163邮箱)
EMAIL_HOST=smtp.163.com
EMAIL_USER=sbox520
EMAIL_PASS=your-email-authorization-code
EMAIL_SENDER=sbox520@163.com
# SMTP_PORT=465        # 465=SSL, 587=STARTTLS, 25=明文
# SMTP_USE_SSL=True

# Debug 模式 (生产环境请设为 False)
DEBUG=False

# 站点 URL
SITE_URL=https://sbox.yearnstudio.cn

# 外部服务 URL（可按部署环境覆盖）
# TURBOWARP_ORIGIN=https://turbowarp.org
# SBOXAPI_URL=https://sboxapi.yearnstudio.cn
# SCRATCH_EXTENSION_URL=https://api.yearnstudio.cn/static/one.js
# CDN_MARKDOWN_URL=https://shunian.scerpark.cn/markdown/markdown.js
